# Garage (S3) for the FAMAT Test Bank's Originals and PDFs. Single node,
# listening on 127.0.0.1 in famat-net only. Configuration in
# /etc/famat/garage.toml (deploy/garage/garage.toml); the RPC secret is the
# famat-garage-rpc-secret Podman secret. After the first start, run
# deploy/garage/bootstrap.sh once (layout, bucket, key).

[Unit]
Description=FAMAT Test Bank Garage
BindsTo=famat-net.service
After=famat-net.service

[Container]
ContainerName=famat-garage
# famat-net's network namespace: 127.0.0.1 is shared with the others.
Network=famat-net.container
# Pinned: Garage has no moving tag per major version, so it is upgraded by
# hand (docs/deploy/upgrading.md).
Image=docker.io/dxflrs/garage:v2.6.0
Volume=/etc/famat/garage.toml:/etc/garage.toml:ro
Volume=famat-garage-meta.volume:/var/lib/garage/meta
Volume=famat-garage-data.volume:/var/lib/garage/data
# As a file, not an env secret: Podman's health check exec does not get
# env-type secrets, so `garage status` there would have no RPC secret.
Secret=famat-garage-rpc-secret,type=mount,target=/run/secrets/garage-rpc-secret,mode=0400
Environment=GARAGE_RPC_SECRET_FILE=/run/secrets/garage-rpc-secret
Environment=RUST_LOG=garage=info
# Exec form: the image has no shell for the string form's `sh -c`.
HealthCmd=["/garage", "status"]
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=30s
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target
