# Postgres for the FAMAT Test Bank. Listens on 127.0.0.1 in famat-net only.
#
# The password comes from the famat-db-password Podman secret, and is used
# only the first time, when the data volume is empty. Changing the secret
# later does not change the database's password (see docs/deploy/upgrading.md).

[Unit]
Description=FAMAT Test Bank Postgres
BindsTo=famat-net.service
After=famat-net.service

[Container]
ContainerName=famat-postgres
# famat-net's network namespace: 127.0.0.1 is shared with the others.
Network=famat-net.container
# Minor releases only; a major upgrade needs a dump and restore.
Image=docker.io/library/postgres:17
AutoUpdate=registry
Environment=POSTGRES_USER=famat POSTGRES_DB=famat
Secret=famat-db-password,type=env,target=POSTGRES_PASSWORD
Volume=famat-pg.volume:/var/lib/postgresql/data
# Bind only to loopback: famat-net's address is reachable from the host's
# container bridge, and nothing else needs Postgres.
Exec=postgres -c listen_addresses=127.0.0.1
ShmSize=256m
# Ready only once the real server answers on TCP (the image's first-start
# initialisation runs a socket-only server first).
HealthCmd=pg_isready -h 127.0.0.1 -U famat -d famat
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=30s
# systemd counts the unit as started only once it is healthy, so the app's
# After= waits for a database that answers.
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=multi-user.target default.target
