#!/usr/bin/env bash
# Run a `famat` CLI command (import, set-passcode, --help) on the server, in a
# one-off container from the app's image in famat-net's network namespace, so
# it reaches Postgres and Garage on 127.0.0.1 with the same secrets as the app.
#
#   sudo famat set-passcode
#   sudo famat --input /srv/famat/import import --sheet /input/sheet.csv … --dry-run
#
# --input DIR mounts DIR read-only at /input; give the command paths under
# /input. Settings (environment): FAMAT_IMAGE (default the app unit's image,
# ghcr.io/robertconde/famat-tests:latest), FAMAT_NET (default famat-net).
set -euo pipefail

IMAGE="${FAMAT_IMAGE:-ghcr.io/robertconde/famat-tests:latest}"
NET="${FAMAT_NET:-famat-net}"

mounts=()
if [ "${1:-}" = "--input" ]; then
  [ -d "${2:-}" ] || { echo "famat: --input needs a directory" >&2; exit 2; }
  mounts=(-v "$(cd "$2" && pwd):/input:ro")
  shift 2
fi

tty=()
[ -t 0 ] && tty=(-t)

exec podman run --rm -i "${tty[@]}" --network "container:$NET" \
  -e DATABASE_URL=postgres://famat@127.0.0.1:5432/famat \
  --secret famat-db-password,type=env,target=PGPASSWORD \
  -e S3_ENDPOINT=http://127.0.0.1:3900 -e S3_REGION=garage -e S3_BUCKET=famat \
  --secret famat-s3-access-key-id,type=env,target=S3_ACCESS_KEY_ID \
  --secret famat-s3-secret-access-key,type=env,target=S3_SECRET_ACCESS_KEY \
  "${mounts[@]}" \
  "$IMAGE" "$@"
