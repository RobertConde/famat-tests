#!/usr/bin/env bash
# Run a `famat` CLI command (import, set-passcode, --help) on the server, in a
# one-off container of the compose file's app service: the app's image, on
# the famat-backend network, with the app's environment and secrets, so it
# reaches Postgres and Garage just as the app does.
#
#   sudo famat set-passcode
#   sudo famat --input /srv/famat/import import --sheet /input/sheet.csv … --dry-run
#
# --input DIR mounts DIR read-only at /input; give the command paths under
# /input. Settings (environment): FAMAT_DIR (default /etc/famat, where the
# compose file is).
set -euo pipefail

DIR="${FAMAT_DIR:-/etc/famat}"

mounts=()
if [ "${1:-}" = "--input" ]; then
  [ -d "${2:-}" ] || { echo "famat: --input needs a directory" >&2; exit 2; }
  mounts=(--volume "$(cd "$2" && pwd):/input:ro")
  shift 2
fi

# A terminal only when there is one (set-passcode's no-echo prompt needs it);
# piped input still reaches the command.
tty=()
[ -t 0 ] && [ -t 1 ] || tty=(-T)

exec docker compose --project-directory "$DIR" run --rm --no-deps "${tty[@]}" "${mounts[@]}" app "$@"
