[Unit]
Description=Daily image updates for the FAMAT Test Bank, with rollback

[Timer]
# After the nightly backup (03:30, plus up to 20 min), so a fresh dump exists
# before Postgres is updated. famat-update waits for a running backup.
OnCalendar=*-*-* 05:00:00
RandomizedDelaySec=30m
Persistent=true

[Install]
WantedBy=timers.target
